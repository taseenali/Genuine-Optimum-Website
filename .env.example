# Contact form mail, used by app/api/contact/route.ts. Set real values in
# Vercel Project Settings (Production + Preview). Never commit real credentials.
#
# EMAIL_USER / EMAIL_PASS are the mailbox the server logs in to (Hostinger SMTP).
# Use a real mailbox on the domain, for example contact@genuineoptimum.com.
EMAIL_USER=contact@genuineoptimum.com
EMAIL_PASS=your-smtp-password

# Optional. Where enquiries are delivered. Defaults to contact@genuineoptimum.com,
# so it only needs setting to send them somewhere else.
CONTACT_TO_EMAIL=

# Optional. Defaults to Hostinger (smtp.hostinger.com, port 587). Change only to
# use another mail provider.
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=

# Optional: a Slack incoming-webhook or Discord webhook URL. If set, a failed
# contact-form email delivery posts a real-time alert here in addition to the
# server log, so a lead is never silently lost.
ALERT_WEBHOOK_URL=

# Optional: Search Console / Bing ownership meta tags. DNS verification needs
# no code and is preferred; these are the fallback.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
