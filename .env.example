# Hostinger SMTP credentials used by app/api/contact/route.ts to deliver
# contact-form submissions. Set real values in Vercel Project Settings
# (Production + Preview environments) — never commit real credentials.
EMAIL_USER=your-email@genuineoptimum.com
EMAIL_PASS=your-smtp-password

# Optional: a Slack incoming-webhook or Discord webhook URL. If set, a
# failed contact-form email delivery posts a real-time alert here in
# addition to the server log, so a lead is never silently lost.
ALERT_WEBHOOK_URL=
